---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";
import { absoluteUrl, withBase } from "../lib/site";

const {
  title = "UBC Trading Group Quant Prep",
  description = "Interactive quant interview prep games, concept write-ups, and worked questions.",
  image = "/assets/quant-prep-hero.webp",
  type = "website",
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://ubctradinggroup.com");
const canonicalUrl = absoluteUrl(Astro.url.pathname, siteUrl);
const imageUrl = absoluteUrl(image, siteUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta property="og:site_name" content="UBC Trading Group Quant Prep" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen bg-bg text-ink">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
