---
const { concepts = [], questions = [], games = [] } = Astro.props;

const groups = [
  {
    label: "Related Concepts",
    items: concepts,
    href: (item) => `/concepts/${item.id}`,
    meta: (item) => item.data.topic,
    tone: "text-accent",
  },
  {
    label: "Related Questions",
    items: questions,
    href: (item) => `/questions/${item.id}`,
    meta: (item) => `${item.data.difficulty} / ${item.data.type}`,
    tone: "text-accent-2",
  },
  {
    label: "Related Games",
    items: games,
    href: (item) => `/games/${item.id}`,
    meta: (item) => item.data.skill,
    tone: "text-warn",
  },
].filter((group) => group.items.length > 0);
---

{
  groups.length > 0 && (
    <aside class="mt-12 border-t border-line pt-6" aria-label="Related practice">
      <h2 class="text-2xl font-black">Keep practicing</h2>
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        {groups.map((group) => (
          <section>
            <h3 class={`text-sm font-black uppercase ${group.tone}`}>{group.label}</h3>
            <div class="mt-3 grid gap-3">
              {group.items.map((item) => (
                <a
                  class="group block rounded-lg border border-line bg-surface p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md"
                  href={group.href(item)}
                >
                  <span class="block font-black group-hover:text-accent">{item.data.title}</span>
                  <span class="mt-1 block text-sm font-bold text-muted">{group.meta(item)}</span>
                  <span class="mt-2 block text-sm leading-6 text-muted">{item.data.description}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </aside>
  )
}
