---
const { label, tone = "neutral" } = Astro.props;

const toneClass =
  tone === "accent"
    ? "border-accent/30 bg-accent/10 text-accent"
    : tone === "blue"
      ? "border-accent-2/30 bg-accent-2/10 text-accent-2"
      : tone === "warn"
        ? "border-warn/30 bg-warn/10 text-warn"
        : "border-line bg-panel text-muted";
---

<span class={`inline-flex rounded-md border px-2.5 py-1 text-xs font-bold ${toneClass}`}>
  {label}
</span>
