---
import { withBase } from "../../lib/site";

const nav = [
  { href: "/games", label: "Games" },
  { href: "/concepts", label: "Concepts" },
  { href: "/questions", label: "Questions" },
  { href: "https://ubctradinggroup.com", label: "Club" },
];
---

<header class="sticky top-0 z-20 border-b border-line bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
    <a href={withBase("/")} class="flex items-center gap-3 font-black" aria-label="UBC Trading Group Quant Prep home">
      <img
        src={withBase("/assets/brand/ubctg-mark.png")}
        alt=""
        class="size-10 object-contain"
        loading="eager"
        decoding="async"
      />
      <span>UBC Trading Group</span>
    </a>

    <nav class="flex flex-wrap gap-2 text-sm font-semibold text-muted">
      {nav.map((item) => (
        <a
          href={withBase(item.href)}
          class="rounded-md px-3 py-2 transition hover:bg-panel hover:text-accent"
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
