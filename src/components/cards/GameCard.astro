---
const { game } = Astro.props;
---

<a
  href={`/games/${game.id}`}
  class="block rounded-lg border border-line bg-surface p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-warn/40 hover:shadow-md"
>
  <p class="text-xs font-bold uppercase text-warn">{game.data.category}</p>
  <h2 class="mt-2 text-xl font-black">{game.data.title}</h2>
  <p class="mt-2 text-sm leading-6 text-muted">{game.data.description}</p>
  <p class="mt-4 text-xs font-bold text-muted">{game.data.skill}</p>
</a>
