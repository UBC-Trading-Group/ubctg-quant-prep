---
import { withBase } from "../../lib/site";

const { concept } = Astro.props;
---

<a
  href={withBase(`/concepts/${concept.id}`)}
  class="block rounded-lg border border-line bg-surface p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md"
>
  <p class="text-xs font-bold uppercase text-accent">{concept.data.topic}</p>
  <h2 class="mt-2 text-xl font-black">{concept.data.title}</h2>
  <p class="mt-2 text-sm leading-6 text-muted">{concept.data.description}</p>
  <p class="mt-4 text-xs font-bold text-muted">{concept.data.difficulty}</p>
</a>
