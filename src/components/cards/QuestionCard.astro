---
const { question } = Astro.props;
---

<a
  href={`/questions/${question.id}`}
  class="block rounded-lg border border-line bg-surface p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-accent-2/40 hover:shadow-md"
>
  <p class="text-xs font-bold uppercase text-accent-2">{question.data.topic}</p>
  <h2 class="mt-2 text-xl font-black">{question.data.title}</h2>
  <p class="mt-2 text-sm leading-6 text-muted">{question.data.description}</p>
  <p class="mt-4 text-xs font-bold text-muted">
    {question.data.difficulty} / {question.data.type}
  </p>
</a>
