---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/site";

const games = await getCollection("games");

const slugify = (value) =>
  value
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const byCategory = (category) =>
  games
    .filter((game) => game.data.category === category)
    .sort((a, b) => a.data.title.localeCompare(b.data.title));

const gameCount = (category) => byCategory(category).length;
const gameByHref = (href) => games.find((game) => href === `/games/${game.id}`);
const difficultyCount = (difficulty) => games.filter((game) => game.data.difficulty === difficulty).length;

const categories = [
  {
    name: "Speed and Precision",
    label: "Speed",
    symbol: "×",
    href: "/games/mental-math-sprint",
    accent: "bg-warn",
    text: "text-warn",
    border: "hover:border-warn/50",
  },
  {
    name: "Probability Foundations",
    label: "Probability",
    symbol: "σ",
    href: "/games/dice-probability-grid",
    accent: "bg-accent-2",
    text: "text-accent-2",
    border: "hover:border-accent-2/50",
  },
  {
    name: "EV and Betting",
    label: "EV",
    symbol: "EV",
    href: "/games/ev-take-or-pass",
    accent: "bg-accent",
    text: "text-accent",
    border: "hover:border-accent/50",
  },
  {
    name: "Card, Dice & Hidden Information",
    label: "Cards & Dice",
    symbol: "□",
    href: "/games/dice-market-game",
    accent: "bg-accent-2",
    text: "text-accent-2",
    border: "hover:border-accent-2/50",
  },
  {
    name: "Relative Value & Arbitrage",
    label: "Arbitrage",
    symbol: "↔",
    href: "/games/fruit-market",
    accent: "bg-ink",
    text: "text-ink",
    border: "hover:border-ink/50",
  },
  {
    name: "Derivatives & Quant-Dev Practice",
    label: "Derivatives",
    symbol: "IV",
    href: "/games/greeks-slider-lab",
    accent: "bg-accent-2",
    text: "text-accent-2",
    border: "hover:border-accent-2/50",
  },
  {
    name: "Calibration & Fermi Estimation",
    label: "Calibration",
    symbol: "±",
    href: "/games/fermi-answer-game",
    accent: "bg-warn",
    text: "text-warn",
    border: "hover:border-warn/50",
  },
  {
    name: "Market Making",
    label: "Markets",
    symbol: "MM",
    href: "/games/make-me-a-market",
    accent: "bg-accent",
    text: "text-accent",
    border: "hover:border-accent/50",
  },
  {
    name: "Adverse Selection & Information",
    label: "Information",
    symbol: "?",
    href: "/games/stale-quote-game",
    accent: "bg-ink",
    text: "text-ink",
    border: "hover:border-ink/50",
  },
];

const featuredCategories = categories.map((category) => category.name);
const otherGames = games
  .filter((game) => !featuredCategories.includes(game.data.category))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const difficultyTone = {
  Beginner: "border-accent/25 bg-accent/10 text-accent",
  Intermediate: "border-accent-2/25 bg-accent-2/10 text-accent-2",
  Advanced: "border-warn/25 bg-warn/10 text-warn",
};
---

<BaseLayout
  title="Quant Interview Practice Games | UBC Trading Group"
  description="Interactive quant interview prep games for expected value, probability, market making, options, estimation, and mental math."
>
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-10">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm font-black uppercase text-accent">Training menu</p>
          <h1 class="mt-2 text-4xl font-black">Games</h1>
          <p class="mt-3 max-w-2xl text-muted">
            Pick a mode and start a drill.
          </p>
        </div>

        <div class="grid grid-cols-3 gap-3 text-center sm:min-w-96">
          <div class="rounded-lg border border-line bg-bg px-4 py-3">
            <p class="text-2xl font-black text-accent">{games.length}</p>
            <p class="text-xs font-black uppercase text-muted">Games</p>
          </div>
          <div class="rounded-lg border border-line bg-bg px-4 py-3">
            <p class="text-2xl font-black text-accent-2">{difficultyCount("Beginner")}</p>
            <p class="text-xs font-black uppercase text-muted">Beginner</p>
          </div>
          <div class="rounded-lg border border-line bg-bg px-4 py-3">
            <p class="text-2xl font-black text-warn">{difficultyCount("Advanced") + difficultyCount("Intermediate")}</p>
            <p class="text-xs font-black uppercase text-muted">Harder</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((category) => {
        const start = gameByHref(category.href) ?? byCategory(category.name)[0];
        return (
          <a
            href={`#${slugify(category.name)}`}
            class={`group overflow-hidden rounded-lg border border-line bg-surface shadow-sm transition hover:-translate-y-0.5 hover:shadow-md ${category.border}`}
          >
            <div class={`h-2 ${category.accent}`}></div>
            <div class="grid gap-4 p-4">
              <div class="flex items-center justify-between gap-3">
                <span class={`grid size-14 shrink-0 place-items-center rounded-lg ${category.accent} text-base font-black text-white`}>
                  {category.symbol}
                </span>
                <span class="min-w-14 shrink-0 text-right">
                  <span class="block text-3xl font-black text-ink">{gameCount(category.name)}</span>
                  <span class="block text-xs font-black uppercase text-muted">games</span>
                </span>
              </div>

              <div>
                <h2 class="text-lg font-black group-hover:text-accent">{category.label}</h2>
                <p class="mt-2 min-h-10 text-sm font-bold leading-5 text-muted">
                  Start: {start?.data.title ?? "Coming soon"}
                </p>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <div class="mt-8 flex flex-wrap gap-2 border-y border-line py-4">
      {categories.map((category) => (
        <a
          href={`#${slugify(category.name)}`}
          class="rounded-md border border-line bg-surface px-3 py-2 text-sm font-black text-muted transition hover:border-accent/40 hover:text-accent"
        >
          {category.label}
        </a>
      ))}
    </div>

    <div class="mt-10 grid gap-10">
      {categories.map((category) => {
        const categoryGames = byCategory(category.name);
        return (
          <section id={slugify(category.name)} class="scroll-mt-28">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class={`grid size-11 place-items-center rounded-lg ${category.accent} text-sm font-black text-white`}>
                  {category.symbol}
                </span>
                <div>
                  <p class={`text-sm font-black uppercase ${category.text}`}>{category.label}</p>
                  <h2 class="text-2xl font-black">{category.name}</h2>
                </div>
              </div>
              <a href={withBase(category.href)} class="rounded-lg bg-accent px-4 py-2 text-sm font-black text-white transition hover:bg-[#6f2030]">
                Start
              </a>
            </div>

            <div class="grid gap-3">
              {categoryGames.map((game) => (
                <a
                  href={withBase(`/games/${game.id}`)}
                  class="grid gap-3 rounded-lg border border-line bg-surface p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md md:grid-cols-[1fr_auto] md:items-center"
                >
                  <span class="min-w-0">
                    <span class="flex min-w-0 flex-wrap items-center gap-2">
                      <span class="font-black">{game.data.title}</span>
                      <span class={`rounded-md border px-2 py-1 text-xs font-black uppercase ${difficultyTone[game.data.difficulty]}`}>
                        {game.data.difficulty}
                      </span>
                    </span>
                    <span class="mt-2 block truncate text-sm font-bold text-muted">{game.data.skill}</span>
                  </span>
                  <span class="inline-flex w-fit rounded-md border border-accent/30 bg-accent/10 px-3 py-2 text-sm font-black text-accent">
                    Play
                  </span>
                </a>
              ))}
            </div>
          </section>
        );
      })}

      {otherGames.length > 0 && (
        <section class="scroll-mt-28">
          <div class="mb-4 flex items-center gap-3">
            <span class="grid size-11 place-items-center rounded-lg bg-panel text-sm font-black text-ink">+</span>
            <div>
              <p class="text-sm font-black uppercase text-muted">More</p>
              <h2 class="text-2xl font-black">Other Games</h2>
            </div>
          </div>

          <div class="grid gap-3">
            {otherGames.map((game) => (
              <a
                href={withBase(`/games/${game.id}`)}
                class="grid gap-3 rounded-lg border border-line bg-surface p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md md:grid-cols-[1fr_auto] md:items-center"
              >
                <span class="min-w-0">
                  <span class="flex min-w-0 flex-wrap items-center gap-2">
                    <span class="font-black">{game.data.title}</span>
                    <span class={`rounded-md border px-2 py-1 text-xs font-black uppercase ${difficultyTone[game.data.difficulty]}`}>
                      {game.data.difficulty}
                    </span>
                  </span>
                  <span class="mt-2 block truncate text-sm font-bold text-muted">{game.data.skill}</span>
                </span>
                <span class="inline-flex w-fit rounded-md border border-accent/30 bg-accent/10 px-3 py-2 text-sm font-black text-accent">
                  Play
                </span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </section>
</BaseLayout>
