---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/shared/Tag.astro";
import RelatedContent from "../../components/shared/RelatedContent.astro";
import { withBase } from "../../lib/site";

export async function getStaticPaths() {
  const questions = (await getCollection("questions")).sort((a, b) => a.id.localeCompare(b.id));

  return questions.map((question, index) => ({
    params: { slug: question.id },
    props: {
      question,
      previousQuestion: questions[index - 1] ?? null,
      nextQuestion: questions[index + 1] ?? null,
    },
  }));
}

const { question, previousQuestion, nextQuestion } = Astro.props;
const { Content } = await render(question);
const [concepts, games] = await Promise.all([
  getCollection("concepts"),
  getCollection("games"),
]);
const relatedConcepts = concepts.filter((concept) => question.data.relatedConcepts?.includes(concept.id));
const relatedGames = games.filter((game) => question.data.relatedGames?.includes(game.id));
const pageTitle = question.data.seoTitle ?? question.data.title;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: question.data.title,
  description: question.data.description,
  educationalLevel: question.data.difficulty,
  about: question.data.tags,
  learningResourceType: "Worked question",
};
---

<BaseLayout title={`${pageTitle} | UBC Trading Group`} description={question.data.description} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <div class="flex flex-wrap gap-2">
      <Tag label={question.data.topic} tone="blue" />
      <Tag label={question.data.difficulty} />
      <Tag label={question.data.type} />
    </div>

    <h1 class="mt-4 text-4xl font-black">{question.data.title}</h1>
    <p class="mt-4 text-lg leading-8 text-muted">{question.data.description}</p>

    <div class="prose question-content mt-10 max-w-none">
      <Content />
    </div>

    <RelatedContent concepts={relatedConcepts} games={relatedGames} />

    <nav class="mt-12 grid gap-3 border-t border-line pt-6 sm:grid-cols-2" aria-label="Worked problem navigation">
      {
        previousQuestion ? (
          <a class="group rounded-lg border border-line bg-surface p-4 shadow-sm transition hover:border-accent-2" href={withBase(`/questions/${previousQuestion.id}`)}>
            <span class="text-xs font-black uppercase text-muted">Previous</span>
            <span class="mt-1 block font-black group-hover:text-accent-2">{previousQuestion.data.title}</span>
          </a>
        ) : (
          <span class="hidden sm:block" aria-hidden="true" />
        )
      }
      {
        nextQuestion && (
          <a class="group rounded-lg border border-line bg-surface p-4 text-left shadow-sm transition hover:border-accent-2 sm:text-right" href={withBase(`/questions/${nextQuestion.id}`)}>
            <span class="text-xs font-black uppercase text-muted">Next</span>
            <span class="mt-1 block font-black group-hover:text-accent-2">{nextQuestion.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>

  <script>
    const content = document.querySelector(".question-content");

    if (content) {
      const collapsibleHeadings = [...content.querySelectorAll("h2")].filter((heading) => {
        const text = heading.textContent?.trim().toLowerCase() ?? "";
        return text.startsWith("hint") || text === "solution";
      });

      for (const heading of collapsibleHeadings) {
        const headingText = heading.textContent?.trim() || "Section";
        const isSolution = headingText.toLowerCase() === "solution";

        const details = document.createElement("details");
        details.className = isSolution ? "solution-disclosure" : "hint-disclosure";

        const summary = document.createElement("summary");
        summary.textContent = headingText;
        details.append(summary);

        const body = document.createElement("div");
        body.className = isSolution ? "solution-disclosure-body" : "hint-disclosure-body";

        let sibling = heading.nextSibling;
        while (
          sibling &&
          !(sibling instanceof HTMLHeadingElement && sibling.tagName === "H2")
        ) {
          const next = sibling.nextSibling;
          body.append(sibling);
          sibling = next;
        }

        details.append(body);
        heading.replaceWith(details);
      }
    }
  </script>
</BaseLayout>
