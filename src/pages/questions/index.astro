---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/site";

const questions = await getCollection("questions");

const slugify = (value) =>
  value
    .toLowerCase()
    .replace(/&/g, "and")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const byTopics = (topics) =>
  questions
    .filter((question) => topics.includes(question.data.topic))
    .sort((a, b) => a.data.title.localeCompare(b.data.title));

const difficultyCount = (difficulty) => questions.filter((question) => question.data.difficulty === difficulty).length;
const typeCount = (types) => questions.filter((question) => types.includes(question.data.type)).length;
const formatType = (type) => type.replace("-", " ");

const topicGroups = [
  {
    label: "Expected Value",
    symbol: "EV",
    topics: ["Expected Value"],
    accent: "bg-accent",
    text: "text-accent",
    border: "hover:border-accent/50",
  },
  {
    label: "Probability",
    symbol: "σ",
    topics: ["Probability"],
    accent: "bg-accent-2",
    text: "text-accent-2",
    border: "hover:border-accent-2/50",
  },
  {
    label: "Bayes",
    symbol: "P|B",
    topics: ["Conditional Probability", "Bayes Rule"],
    accent: "bg-accent-2",
    text: "text-accent-2",
    border: "hover:border-accent-2/50",
  },
  {
    label: "Statistics",
    symbol: "Σ",
    topics: ["Statistics"],
    accent: "bg-warn",
    text: "text-warn",
    border: "hover:border-warn/50",
  },
  {
    label: "Options",
    symbol: "Δ",
    topics: ["Options"],
    accent: "bg-accent",
    text: "text-accent",
    border: "hover:border-accent/50",
  },
  {
    label: "Market Making",
    symbol: "MM",
    topics: ["Market Making"],
    accent: "bg-accent",
    text: "text-accent",
    border: "hover:border-accent/50",
  },
  {
    label: "Programming",
    symbol: "{}",
    topics: ["Programming", "Algorithms"],
    accent: "bg-ink",
    text: "text-ink",
    border: "hover:border-ink/50",
  },
  {
    label: "Calculus",
    symbol: "dx",
    topics: ["Calculus"],
    accent: "bg-accent-2",
    text: "text-accent-2",
    border: "hover:border-accent-2/50",
  },
  {
    label: "Estimation & Models",
    symbol: "±",
    topics: ["Estimation", "Modeling", "Time Series", "Game Theory"],
    accent: "bg-warn",
    text: "text-warn",
    border: "hover:border-warn/50",
  },
];

const topicStats = (topics) => {
  const items = byTopics(topics);
  return {
    total: items.length,
    easy: items.filter((question) => question.data.difficulty === "Easy").length,
    medium: items.filter((question) => question.data.difficulty === "Medium").length,
    hard: items.filter((question) => question.data.difficulty === "Hard").length,
  };
};

const difficultyTone = {
  Easy: "border-accent/25 bg-accent/10 text-accent",
  Medium: "border-accent-2/25 bg-accent-2/10 text-accent-2",
  Hard: "border-warn/25 bg-warn/10 text-warn",
};

const typeTone = {
  numeric: "border-accent/25 bg-accent/10 text-accent",
  conceptual: "border-accent-2/25 bg-accent-2/10 text-accent-2",
  proof: "border-warn/25 bg-warn/10 text-warn",
  coding: "border-ink/20 bg-panel text-ink",
  "market-making": "border-accent/25 bg-accent/10 text-accent",
};
---

<BaseLayout
  title="Quant Interview Worked Questions | UBC Trading Group"
  description="Practice quant interview questions with hints, worked solutions, and topic-based drills across probability, statistics, options, programming, and market making."
>
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-10">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="text-sm font-black uppercase text-accent">Question bank</p>
          <h1 class="mt-2 text-4xl font-black">Worked Questions</h1>
          <p class="mt-3 max-w-2xl text-muted">
            Pick a topic, then solve by difficulty or format.
          </p>
        </div>

        <div class="grid grid-cols-4 gap-2 text-center sm:min-w-[28rem]">
          <div class="rounded-lg border border-line bg-bg px-3 py-3">
            <p class="text-2xl font-black text-accent">{questions.length}</p>
            <p class="text-xs font-black uppercase text-muted">Total</p>
          </div>
          <div class="rounded-lg border border-line bg-bg px-3 py-3">
            <p class="text-2xl font-black text-accent">{difficultyCount("Easy")}</p>
            <p class="text-xs font-black uppercase text-muted">Easy</p>
          </div>
          <div class="rounded-lg border border-line bg-bg px-3 py-3">
            <p class="text-2xl font-black text-accent-2">{difficultyCount("Medium")}</p>
            <p class="text-xs font-black uppercase text-muted">Medium</p>
          </div>
          <div class="rounded-lg border border-line bg-bg px-3 py-3">
            <p class="text-2xl font-black text-warn">{difficultyCount("Hard")}</p>
            <p class="text-xs font-black uppercase text-muted">Hard</p>
          </div>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap gap-2 text-sm font-black text-muted">
        <span class="rounded-md border border-line bg-bg px-3 py-2">{typeCount(["coding"])} coding</span>
        <span class="rounded-md border border-line bg-bg px-3 py-2">{typeCount(["market-making"])} market-making</span>
        <span class="rounded-md border border-line bg-bg px-3 py-2">{typeCount(["numeric"])} numeric</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {topicGroups.map((group) => {
        const stats = topicStats(group.topics);
        return (
          <a
            href={`#${slugify(group.label)}`}
            class={`group overflow-hidden rounded-lg border border-line bg-surface shadow-sm transition hover:-translate-y-0.5 hover:shadow-md ${group.border}`}
          >
            <div class={`h-2 ${group.accent}`}></div>
            <div class="grid gap-4 p-4">
              <div class="flex items-center justify-between gap-3">
                <span class={`grid size-14 shrink-0 place-items-center rounded-lg ${group.accent} text-base font-black text-white`}>
                  {group.symbol}
                </span>
                <span class="min-w-16 shrink-0 text-right">
                  <span class="block text-3xl font-black text-ink">{stats.total}</span>
                  <span class="block text-xs font-black uppercase text-muted">questions</span>
                </span>
              </div>

              <div>
                <h2 class="text-lg font-black group-hover:text-accent">{group.label}</h2>
                <div class="mt-3 grid grid-cols-3 gap-2">
                  <span class="rounded-md border border-line bg-bg px-2 py-2 text-center">
                    <span class="block text-sm font-black text-accent">{stats.easy}</span>
                    <span class="block text-xs font-black uppercase text-muted">Easy</span>
                  </span>
                  <span class="rounded-md border border-line bg-bg px-2 py-2 text-center">
                    <span class="block text-sm font-black text-accent-2">{stats.medium}</span>
                    <span class="block text-xs font-black uppercase text-muted">Med</span>
                  </span>
                  <span class="rounded-md border border-line bg-bg px-2 py-2 text-center">
                    <span class="block text-sm font-black text-warn">{stats.hard}</span>
                    <span class="block text-xs font-black uppercase text-muted">Hard</span>
                  </span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <div class="mt-8 flex flex-wrap gap-2 border-y border-line py-4">
      {topicGroups.map((group) => (
        <a
          href={`#${slugify(group.label)}`}
          class="rounded-md border border-line bg-surface px-3 py-2 text-sm font-black text-muted transition hover:border-accent/40 hover:text-accent"
        >
          {group.label}
        </a>
      ))}
    </div>

    <div class="mt-10 grid gap-10">
      {topicGroups.map((group) => {
        const groupQuestions = byTopics(group.topics);
        return (
          <section id={slugify(group.label)} class="scroll-mt-28">
            <div class="mb-4 flex items-center gap-3">
              <span class={`grid size-11 place-items-center rounded-lg ${group.accent} text-sm font-black text-white`}>
                {group.symbol}
              </span>
              <div>
                <p class={`text-sm font-black uppercase ${group.text}`}>{group.label}</p>
                <h2 class="text-2xl font-black">{group.topics.join(" / ")}</h2>
              </div>
            </div>

            <div class="grid gap-3">
              {groupQuestions.map((question) => (
                <a
                  href={withBase(`/questions/${question.id}`)}
                  class="grid gap-3 rounded-lg border border-line bg-surface p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md md:grid-cols-[1fr_auto] md:items-center"
                >
                  <span class="min-w-0">
                    <span class="flex min-w-0 flex-wrap items-center gap-2">
                      <span class="font-black">{question.data.title}</span>
                      <span class={`rounded-md border px-2 py-1 text-xs font-black uppercase ${difficultyTone[question.data.difficulty]}`}>
                        {question.data.difficulty}
                      </span>
                      <span class={`rounded-md border px-2 py-1 text-xs font-black uppercase ${typeTone[question.data.type]}`}>
                        {formatType(question.data.type)}
                      </span>
                    </span>
                    <span class="mt-2 flex flex-wrap gap-2 text-xs font-black uppercase text-muted">
                      <span>{question.data.topic}</span>
                      {question.data.relatedGames?.length ? <span>{question.data.relatedGames.length} related game{question.data.relatedGames.length === 1 ? "" : "s"}</span> : null}
                      {question.data.relatedConcepts?.length ? <span>{question.data.relatedConcepts.length} related concept{question.data.relatedConcepts.length === 1 ? "" : "s"}</span> : null}
                    </span>
                  </span>
                  <span class="inline-flex w-fit rounded-md border border-accent-2/30 bg-accent-2/10 px-3 py-2 text-sm font-black text-accent-2">
                    Solve
                  </span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>
</BaseLayout>
