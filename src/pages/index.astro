---
import Page from '../layouts/Page.astro';
import introduction from '../guide/introduction.html?raw';
import probability from '../guide/probability.html?raw';
import statistics from '../guide/statistics.html?raw';
import optimization from '../guide/optimization.html?raw';
import timeseries from '../guide/timeseries.html?raw';
import derivatives from '../guide/derivatives.html?raw';
import microstructure from '../guide/microstructure.html?raw';
import portfolios from '../guide/portfolios.html?raw';
import programming from '../guide/programming.html?raw';
import interviews from '../guide/interviews.html?raw';
const subjects = [probability, statistics, optimization, timeseries, derivatives, microstructure, portfolios, programming];
---
<Page>
  <Fragment set:html={introduction} />
  <section id="qgp-subjects">
    <h2 class="qgp-heading">Subject guides</h2>
    {subjects.map(subject => <Fragment set:html={subject} />)}
  </section>
  <Fragment set:html={interviews} />
</Page>
