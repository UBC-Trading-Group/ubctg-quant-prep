---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ConceptCard from "../../components/cards/ConceptCard.astro";

const concepts = await getCollection("concepts");
---

<BaseLayout
  title="Quant Interview Concept Guides | UBC Trading Group"
  description="Short technical explainers for quant interviews, trading, options, probability, statistics, and market making."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-4xl font-black">Concept Write-Ups</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Short technical explainers for quant interviews, trading, options, probability, and statistics.
    </p>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {concepts.map((concept) => <ConceptCard concept={concept} />)}
    </div>
  </section>
</BaseLayout>
