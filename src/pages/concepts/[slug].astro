---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Tag from "../../components/shared/Tag.astro";
import RelatedContent from "../../components/shared/RelatedContent.astro";
import { withBase } from "../../lib/site";

export async function getStaticPaths() {
  const concepts = (await getCollection("concepts")).sort((a, b) => a.id.localeCompare(b.id));

  return concepts.map((concept, index) => ({
    params: { slug: concept.id },
    props: {
      concept,
      previousConcept: concepts[index - 1] ?? null,
      nextConcept: concepts[index + 1] ?? null,
    },
  }));
}

const { concept, previousConcept, nextConcept } = Astro.props;
const { Content } = await render(concept);
const [games, questions] = await Promise.all([
  getCollection("games"),
  getCollection("questions"),
]);
const relatedGames = games.filter((game) => concept.data.relatedGames?.includes(game.id));
const relatedQuestions = questions.filter((question) => concept.data.relatedQuestions?.includes(question.id));
const pageTitle = concept.data.seoTitle ?? concept.data.title;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: concept.data.title,
  description: concept.data.description,
  educationalLevel: concept.data.difficulty,
  about: concept.data.tags,
  learningResourceType: "Concept guide",
};
---

<BaseLayout title={`${pageTitle} | UBC Trading Group`} description={concept.data.description} type="article" jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <div class="flex flex-wrap gap-2">
      <Tag label={concept.data.topic} tone="accent" />
      <Tag label={concept.data.difficulty} />
    </div>

    <h1 class="mt-4 text-4xl font-black">{concept.data.title}</h1>
    <p class="mt-4 text-lg leading-8 text-muted">{concept.data.description}</p>

    <div class="prose mt-10 max-w-none">
      <Content />
    </div>

    <RelatedContent games={relatedGames} questions={relatedQuestions} />

    <nav class="mt-12 grid gap-3 border-t border-line pt-6 sm:grid-cols-2" aria-label="Concept guide navigation">
      {
        previousConcept ? (
          <a class="group rounded-lg border border-line bg-surface p-4 shadow-sm transition hover:border-accent" href={withBase(`/concepts/${previousConcept.id}`)}>
            <span class="text-xs font-black uppercase text-muted">Previous Concept</span>
            <span class="mt-1 block font-black group-hover:text-accent">{previousConcept.data.title}</span>
          </a>
        ) : (
          <span class="hidden sm:block" aria-hidden="true" />
        )
      }
      {
        nextConcept && (
          <a class="group rounded-lg border border-line bg-surface p-4 text-left shadow-sm transition hover:border-accent sm:text-right" href={withBase(`/concepts/${nextConcept.id}`)}>
            <span class="text-xs font-black uppercase text-muted">Next Concept</span>
            <span class="mt-1 block font-black group-hover:text-accent">{nextConcept.data.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
